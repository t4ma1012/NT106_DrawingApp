# PostgreSQL (Neon)
DATABASE_URL=Host=your-db-host;Port=5432;Database=drawingapp;Username=your_user;Password=your_password;

# AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview
GEMINI_TEXT_MODEL=gemini-2.5-flash
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Client -> LB routing
USE_LOAD_BALANCER_ROUTING=1
LOAD_BALANCER_HOST=127.0.0.1
LOAD_BALANCER_PORT=9000

# Drawing server ports
SERVER_TCP_PORT=8888
SERVER_UDP_PORT=8889
SERVER_PUBLIC_HOST=127.0.0.1
SERVER_CERT_PATH=server.pfx
SERVER_CERT_PASSWORD=123456

# Multi-server identity
SERVER_ID=server-1
SERVER_NAME=DrawingServer-1
SERVER_CAPACITY=50
MAX_TCP_CLIENTS=200
MAX_ROOMS=100
MAX_ROOM_MEMBERS=5
HEARTBEAT_INTERVAL_MS=5000

# LB fallback server list (used when servers.json is missing)
LB_SERVER_1_ID=server-1
LB_SERVER_1_NAME=DrawingServer-1
LB_SERVER_1_HOST=127.0.0.1
LB_SERVER_1_TCP_PORT=8888
LB_SERVER_1_UDP_PORT=8889

LB_SERVER_2_ID=server-2
LB_SERVER_2_NAME=DrawingServer-2
LB_SERVER_2_HOST=127.0.0.1
LB_SERVER_2_TCP_PORT=8890
LB_SERVER_2_UDP_PORT=8891
